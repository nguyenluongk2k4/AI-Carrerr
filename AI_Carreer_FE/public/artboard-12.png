    <script>
        function reveal() {
    var reveals = document.querySelectorAll(".reveal");
  
    for (var i = 0; i < reveals.length; i++) {
      var windowHeight = window.innerHeight;
      var elementTop = reveals[i].getBoundingClientRect().top;
      var elementVisible = 150;
  
      if (elementTop < windowHeight - elementVisible) {
        reveals[i].classList.add("active");
      } else {
        reveals[i].classList.remove("active");
      }
    }
  }
  
  window.addEventListener("scroll", reveal);
    </script>
<script>
    var targetElements = [
        document.getElementById('countDisplay1'),
        document.getElementById('countDisplay2'),
        document.getElementById('countDisplay3'),
        document.getElementById('countDisplay4')
    ];
    var targetValues = targetElements.map(function(element) {
        return parseInt(element.textContent);
    });
    var interval = 1; // Thời gian (milliseconds) giữa mỗi lần cập nhật
    var currentValues = [0, 0, 0, 0, 0, 0];
    var isCounting = false;

    function updateCounters() {
        var allReached = true;

        for (var i = 0; i < targetElements.length; i++) {
            if (currentValues[i] < targetValues[i]) {
                currentValues[i] += Math.floor(Math.random() * 10); // Tăng giá trị lên một giá trị ngẫu nhiên
                if (currentValues[i] >= targetValues[i]) {
                    currentValues[i] = targetValues[i]; // Đặt giá trị hiện tại thành giá trị mục tiêu nếu nó vượt quá
                }
                targetElements[i].textContent = currentValues[i];
                allReached = false;
            }
        }

        if (allReached) {
            clearInterval(counterInterval); // Dừng việc cập nhật khi tất cả giá trị đạt giá trị cố định
        }
    }

    function startCounting() {
        if (isCounting) return; // Đã đang đếm, không cần bắt đầu lại

        var windowHeight = window.innerHeight; // Chiều cao cửa sổ trình duyệt
        var elementOffsets = targetElements.map(function(element) {
            return element.getBoundingClientRect().top;
        });

        if (elementOffsets.some(function(offset) {
            return offset - windowHeight <= 0;
        })) {
            isCounting = true; // Bắt đầu đếm khi có ít nhất một phần tử hiển thị trên cửa sổ
            counterInterval = setInterval(updateCounters, interval);

            // Đặt một hàm dừng sau 4 giây
            setTimeout(stopCounting, 1000);
        }
    }

    function stopCounting() {
        clearInterval(counterInterval); // Dừng việc cập nhật
        // Đảm bảo rằng giá trị cuối cùng được hiển thị chính xác
        for (var i = 0; i < targetElements.length; i++) {
            targetElements[i].textContent = targetValues[i];
        }
    }

    // Theo dõi sự kiện cuộn trang
    window.addEventListener('scroll', startCounting);
</script>

