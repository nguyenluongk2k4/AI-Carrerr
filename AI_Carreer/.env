# =============================================
# Hành Trang Số Chatbot — Environment Config
# =============================================
# Copy file này thành .env và điền API key của bạn

# Chọn LLM provider: "gemini" (Google) hoặc "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (lấy tại https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=AIzaSyAOL3GjCYZxvEiHhnIaMWhOtW24TCFan84

# OpenAI API Key (chỉ cần khi LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# Tên model (optional - mặc định như bên dưới)
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Đường dẫn file data
DATA_FILE=data.json

# Đường dẫn lưu ChromaDB
CHROMA_DB_PATH=./chroma_db
